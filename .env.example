# ==============================================================================
# BrandProof AI — Environment Variables Configuration (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# --- Backend Application Settings ---
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# --- Supabase Configuration ---
# Project URL from Supabase dashboard (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# PostgreSQL connection string with pgvector enabled (pooler or direct)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Supabase Anon Key (used for client verification in browser)
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
# Supabase JWT Secret (Backend ONLY — from Supabase Project Settings > API > JWT Settings)
# Used for symmetric HS256 token verification. For asymmetric keys, JWKS is used via SUPABASE_URL.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
# Supabase Service Role Key (Backend administrative ONLY — NEVER used as JWT signing secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
# Storage bucket name for guidelines and assets
SUPABASE_STORAGE_BUCKET=brandproof-guidelines-assets

# --- Google Gemini AI Configuration (Backend ONLY) ---
# Gemini API Key from Google AI Studio / Google Cloud Console
GEMINI_API_KEY=your-gemini-api-key-placeholder
# Model identifiers (set dynamically in Phase 4 via official documentation)
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Feature Flags ---
FEATURE_TONE_ANALYSIS=false

# --- Frontend Environment Variables (Vite prefixed) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
